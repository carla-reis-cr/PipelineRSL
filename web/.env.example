# Supabase (Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Scopus (Elsevier Developer Portal). O token institucional é opcional.
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=
# STANDARD (padrão, sem resumo) ou COMPLETE (com resumo; exige direito institucional)
SCOPUS_VIEW=STANDARD

# IEEE Xplore (developer.ieee.org)
IEEE_API_KEY=
# metadata (padrão) ou fields
IEEE_QUERY_MODE=metadata
